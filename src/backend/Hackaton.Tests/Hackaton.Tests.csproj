<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hackaton.Api\Hackaton.Api.csproj" />
    <ProjectReference Include="..\Hackaton.Services\Hackaton.Services.csproj" />
    <ProjectReference Include="..\Hackaton.Data\Hackaton.Data.csproj" />
    <ProjectReference Include="..\Hackaton.Domain\Hackaton.Domain.csproj" />
    <ProjectReference Include="..\Hackaton.Shared\Hackaton.Shared.csproj" />
  </ItemGroup>

</Project>
