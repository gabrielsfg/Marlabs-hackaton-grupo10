@Hackaton.Api_HostAddress = http://localhost:5058

GET {{Hackaton.Api_HostAddress}}/api/health
Accept: application/json

###

POST {{Hackaton.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "maria@email.com",
  "cpf": "529.982.247-25",
  "phone": "(11) 98765-4321",
  "password": "Senha123"
}

###

# @name login
POST {{Hackaton.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "maria@email.com",
  "password": "Senha123"
}

###

GET {{Hackaton.Api_HostAddress}}/api/reminders
Authorization: Bearer {{login.response.body.$.accessToken}}

###

GET {{Hackaton.Api_HostAddress}}/api/reminders/00000000-0000-7000-8000-000000000001
Authorization: Bearer {{login.response.body.$.accessToken}}

###

POST {{Hackaton.Api_HostAddress}}/api/reminders
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Ligar para o cliente sobre o aporte",
  "dueDate": "2026-10-15",
  "clientId": null
}

###

PUT {{Hackaton.Api_HostAddress}}/api/reminders/00000000-0000-7000-8000-000000000001
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Ligar para o cliente sobre o aporte",
  "dueDate": "2026-10-15",
  "clientId": null,
  "isCompleted": true
}

###

DELETE {{Hackaton.Api_HostAddress}}/api/reminders/00000000-0000-7000-8000-000000000001
Authorization: Bearer {{login.response.body.$.accessToken}}

###

GET {{Hackaton.Api_HostAddress}}/api/users/me
Authorization: Bearer {{login.response.body.$.accessToken}}

